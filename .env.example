# JDBC URL for the Supabase project you want this API to use.
# Replace <PROJECT_REF> with the project reference shown in Supabase > Connect.
DATABASE_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# SMTP para notificacoes de ocorrencia (e-mail HTML com imagens embutidas).
# Gmail exige verificacao em 2 etapas e uma Senha de App (16 digitos):
# https://myaccount.google.com/apppasswords  (a senha normal da conta NAO funciona).
#
# Opcao A - porta 587 com STARTTLS:
#   MAIL_PORT=587 / MAIL_STARTTLS=true / MAIL_SSL=false
# Opcao B - porta 465 com SSL implicito (abaixo):
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=sua-conta@gmail.com
MAIL_PASSWORD=sua-senha-de-app-de-16-digitos
MAIL_SMTP_AUTH=true
MAIL_SSL=true
MAIL_STARTTLS=false

# Optional: browser origins allowed by CORS (comma separated). Default: localhost:8081 and 127.0.0.1:8081.
# CORS_ALLOWED_ORIGINS=http://localhost:8081,http://192.168.0.10:8081

SPRING_PROFILES_ACTIVE=local
