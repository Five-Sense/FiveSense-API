# JDBC URL for the Supabase project you want this API to use.
# Replace <PROJECT_REF> with the project reference shown in Supabase > Connect.
DATABASE_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# Optional SMTP for occurrence notifications and mail features.
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false

# Optional: browser origins allowed by CORS (comma separated). Default: localhost:8081 and 127.0.0.1:8081.
# CORS_ALLOWED_ORIGINS=http://localhost:8081,http://192.168.0.10:8081

SPRING_PROFILES_ACTIVE=local
