# JDBC URL for the Supabase project you want this API to use.
# Replace <PROJECT_REF> with the project reference shown in Supabase > Connect.
DATABASE_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# SMTP para notificacoes de ocorrencia (envio do e-mail + imagem anexada).
# Valores prontos para Gmail. Use uma Senha de App (App Password) de 16 digitos,
# gerada em https://myaccount.google.com/apppasswords (requer verificacao em 2 etapas).
# Nunca use a senha normal da conta Google.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=sua-conta@gmail.com
MAIL_PASSWORD=sua-senha-de-app-de-16-digitos
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# Optional: browser origins allowed by CORS (comma separated). Default: localhost:8081 and 127.0.0.1:8081.
# CORS_ALLOWED_ORIGINS=http://localhost:8081,http://192.168.0.10:8081

SPRING_PROFILES_ACTIVE=local
